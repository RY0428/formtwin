{
  "name": "formtwin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build -w @formtwin/public-app && npm run build -w @formtwin/private-app",
    "check:bundle": "node scripts/check-private-bundle.mjs && node scripts/check-public-bundle.mjs",
    "verify": "npm run check:secrets && npm run check:invariants && npm run lint && npm run typecheck && npm test && npm run build && npm run check:bundle && npm run check:package && npm run test:e2e",
    "test:e2e": "npm run build:e2e -w @formtwin/private-app && npm run build:e2e -w @formtwin/public-app && playwright test --trace off",
    "check:package": "node scripts/forms/check-current-package.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "ui:snapshots": "npm run build:e2e -w @formtwin/private-app && npm run build:e2e -w @formtwin/public-app && node scripts/ui-snapshots.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:hosted": "playwright test -c playwright.hosted.config.ts --trace off",
    "device:check": "node scripts/device/device-check.mjs",
    "release:inventory": "node scripts/release-inventory.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false
  }
}
