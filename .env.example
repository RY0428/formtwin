# Copy to apps/<app>/.env.local (never commit .env.local).
# Firebase Web config values are public identifiers, but keep project-specific
# values out of the repository. App Check debug tokens must NEVER be placed here.

# --- apps/public-app ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# --- apps/private-app ---
# Needed only to construct the Firebase app for on-device inference.
# private-app never initializes App Check, Firestore, Analytics or Remote Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
