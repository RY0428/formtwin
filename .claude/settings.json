{
  "permissions": {
    "allow": [
      "Bash(npm run verify:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:e2e:*)",
      "Bash(npm run ui:snapshots:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(firebase deploy:*)",
      "Read(~/formtwin-signing-key*)",
      "Read(**/formtwin-signing-key*)",
      "Read(**/*.private.jwk.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-secrets.mjs\""
          }
        ]
      }
    ]
  }
}
